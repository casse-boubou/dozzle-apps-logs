ARG FLUENTD_BASE_IMAGE_VERSION="v1.20.1-1.0@sha256:25cf11fc20e20ba8cda58e4bd8a1117da25cb16fbfe46ee560f11b96dcdfb7eb"
FROM fluent/fluentd:${FLUENTD_BASE_IMAGE_VERSION} AS runner
ARG CONTAINER_BUILD_VERSION
ENV CONTAINER_BUILD_VERSION=${CONTAINER_BUILD_VERSION}
USER 0
# Update index, install app, and clean up cache
RUN echo "Installing base packages" \
    && apk --update --no-cache add \
    tzdata=2025b-r0 \
    haproxy=2.8.16-r0 \
    nodejs=20.15.1-r0 \
    npm=10.2.5-r0

# For HAPROXY and NODE
ENV SOCKET_PATH=/var/run/fakeDocker.sock


####################
# FLUENTD
####################
RUN mkdir -p /fluentd/etc && rm /fluentd/etc/fluent.conf


####################
# HAPROXY
####################
COPY ./haproxy/haproxy.cfg /usr/local/etc/haproxy/haproxy.cfg
EXPOSE 2376
ENV PROXY_PORT=":2376" \
    LOG_LEVEL=info \
    CONTAINERS=1 \
    PING=1 \
    VERSION=1 \
    EVENTS=1 \
    INFO=1




##################################
## DEV MODE
##################################
WORKDIR /DEV
CMD ["sleep", "infinity"]
